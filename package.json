{
  "name": "cloudbox-media-vault",
  "version": "1.0.0",
  "description": "Installable CloudBox Media Vault PWA with local storage, media playback, and AI organization tools",
  "scripts": {
    "start": "parcel ./src/index.html",
    "build": "node scripts/clean-dist.mjs && parcel build ./src/index.html",
    "package:pc": "npm run build && node scripts/package-pc.mjs",
    "package:android": "npm run build && node scripts/package-android-twa.mjs",
    "package:all": "npm run package:pc && npm run package:android && npm run package:npm",
    "package:npm": "npm run build && node scripts/package-npm.mjs"
  },
  "devDependencies": {
    "parcel": "^2.0.0",
    "babel-eslint": "^10.1.0",
    "eslint": "^7.2.0"
  },
  "keywords": [
    "pwa",
    "storage",
    "media",
    "vault",
    "android",
    "desktop"
  ],
  "files": [
    "dist",
    "src",
    "docs",
    "scripts",
    "README.md",
    ".env.example"
  ],
  "license": "MIT"
}
